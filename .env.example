# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for rendering Google Maps element on client
# This triggers the API key secret entry workflow in AI Studio.
GOOGLE_MAPS_PLATFORM_KEY=""

# JWT Secrets for Production-Grade Authentication
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Dev-only escape toggle for WebSocket authentication (default false)
ALLOW_INSECURE_WS_AUTH="false"

# Safaricom Daraja API Credentials for Lipa Na M-Pesa STK Push
# Support sandbox / production
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
MPESA_WEBHOOK_SECRET=""

# Redis & BullMQ Configuration
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Nodemailer SMTP Server Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Web-Push VAPID Keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="mailto:houseventuresconsultancy@gmail.com"

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# PostgreSQL Database Configuration

# Recommended production option
DATABASE_URL="postgresql://user:password@host:5432/kazify"

# Alternative individual connection settings

DB_HOST=""
DB_PORT="5432"
DB_NAME="kazify"
DB_USER=""
DB_PASSWORD=""

# Application Environment

NODE_ENV="development"

# Production:
# NODE_ENV="production"

# Database Migration Control

RUN_MIGRATIONS="true"

# Password hashing security configuration
# Increase after benchmarking if required
BCRYPT_ROUNDS="12"